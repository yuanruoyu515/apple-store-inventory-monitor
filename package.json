{
  "name": "apple-store-inventory-monitor",
  "private": true,
  "version": "1.0.27",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "generate:us": "node scripts/generate-us-data.mjs",
    "generate:ca": "node scripts/generate-ca-data.mjs",
    "generate:ae": "node scripts/generate-ae-data.mjs",
    "generate:na": "node scripts/generate-us-data.mjs && node scripts/generate-ca-data.mjs",
    "generate:regions": "pnpm generate:na && pnpm generate:ae",
    "refresh:ca": "node scripts/refresh-canada-data.mjs",
    "refresh:ae": "node scripts/refresh-uae-data.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
