{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apple Store Inventory Monitor US",
  "version": "1.0.6",
  "identifier": "com.suversal.apple-store-inventory-monitor.us",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "果到雷达 · 美国版",
        "width": 1080,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MjUwQTJGRjYyNzY2NjIKUldSaVppZjJMd29scHZ3WlVTbGJ4YnIzRlBNTVVVQmdod0wzUDVpcjVRQmErZUNwY01ob1Z0R20K",
      "endpoints": [
        "https://github.com/suversal/apple-store-inventory-monitor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
